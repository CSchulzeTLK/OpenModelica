// name: whenNestedIfStatements
// keywords: NewBackend, when, if, print
// status: correct
// cflags: --newBackend
// teardown_command: rm -rf WhenNestedIf.Test* _WhenNestedIf.Test* output.log
//
// Nested if- and for-equations inside an if-equation of a when-equation whose
// bodies only contain function calls are collected into the when-algorithm and
// must not fail the lowering of the when-branch.

loadModel(Modelica); getErrorString();
loadString("
package WhenNestedIf
  model Cell
    Real T(start = 300, fixed = true);
    parameter Real Tf = 273.15;
    Real m;
  equation
    der(T) = -1;
    m = if T < 280 then 1 else 0;
    when terminal() then
      if m > 0 then
        if T < Tf then
          Modelica.Utilities.Streams.print(\"warning: condensate below freezing\");
        end if;
        for i in 1:2 loop
          Modelica.Utilities.Streams.print(\"cell \" + String(i));
        end for;
      end if;
    end when;
  end Cell;

  model Test \"nested if with a print inside a when, single cell\"
    Cell cell;
  end Test;

  model TestArray \"nested if with a print inside a when, array of cells\"
    Cell cell[3];
  end TestArray;
end WhenNestedIf;
"); getErrorString();

simulate(WhenNestedIf.Test, stopTime=1.0); getErrorString();
val(cell.T, 1.0);
simulate(WhenNestedIf.TestArray, stopTime=1.0); getErrorString();
val(cell[2].T, 1.0);

// Result:
